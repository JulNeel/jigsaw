# Copy this file to .env.local and fill in the real values yourself.
# .env.local is gitignored (see .gitignore: `.env*`) — never commit real secrets.

# Project Settings -> Data API -> Publishable key (sb_publishable_...)
# Safe for browser/client code — replaces the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> Data API -> Secret key (sb_secret_...)
# SERVER-SIDE ONLY — never NEXT_PUBLIC_*. Replaces the legacy "service_role" key.
# The gateway rejects this key if it's sent from what looks like a browser request.
SUPABASE_SECRET_KEY=

# Project Settings -> Database -> Connection string -> "Direct connection" tab
# (NOT the Transaction pooler / Session pooler string — that mode doesn't
# support the multi-statement BEGIN/FOR UPDATE/COMMIT transactions every
# Server Action in src/lib/rooms/piece-actions.ts relies on. See Architecture
# AD-2/Stack.)
DATABASE_URL=

# Piece image tiles bucket (Architecture AD-3) — must match the bucket you created
SUPABASE_STORAGE_BUCKET=piece-tiles

# Dev-only: artificially delays every Supabase call (auth, db, storage) by this
# many milliseconds, to test loading states under realistic latency. Ignored
# outside `next dev` — never active in production regardless of this value.
NEXT_PUBLIC_DEV_NETWORK_DELAY_MS=

# --- Headless browser tests (`pnpm e2e`) ---------------------------------
# Neither of these belongs in .env.local: both are set by the e2e tooling
# itself, and are listed here only so their existence is discoverable.
#
# E2E_ALLOW_HOSTED_DB=1
#   Required acknowledgement that `pnpm e2e` seeds and deletes rows in the
#   real Supabase project this DATABASE_URL points at. Every room it creates
#   is prefixed `e2e-` and removed afterwards, but the guard makes running
#   against a hosted database a deliberate act:  E2E_ALLOW_HOSTED_DB=1 pnpm e2e
#
# NEXT_PUBLIC_E2E_HOOKS=1
#   Exposes `window.__jigsawE2E`, which lets an automated browser read the
#   live Konva stage transform and piece state — pieces are drawn to a
#   canvas and have no DOM nodes to target. Set only by `pnpm e2e:server`,
#   and doubly gated on NODE_ENV !== production; a production build
#   eliminates the hook entirely (verified by grepping the build output).
